# Normalise line endings: LF in the repository and in the working tree.
# Without this, the Windows working copy stores CRLF while git stores LF,
# and every touched file shows up as fully rewritten in git diff.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
